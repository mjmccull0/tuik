{
  "main": "hub",
  "config": {
    "state": {
      "get": "skate get {{.key}}",
      "set": "skate set {{.key}} {{.value}}"
    }
  },
  "state.set": {
    "test_var": "Hello",
    "dirname": "."
  },
  "styles": {
    "primary": "212",
    "muted": "240",
    "accent": "86",
    "bg": "0"
  },
  "views": {
    "hub": {
      "component": "gum choose",
      "args": [
        "Pager",
        "Pick File",
        "Input Check",
        "Quick Note",
        "Exit",
        "Process Manager"
      ],
      "handler": {
        "Pager": {
          "target": "view:pick_file",
          "state.set": {
            "pick_file_header": "Select a file to view",
            "confirm_msg": "View file: {{.selected_path}}?",
            "confirm_target": "view:pager"
          }
        },
        "Pick File": {
          "target": "view:pick_file",
          "state.set": {
            "input_header": "File Search",
            "pick_file_header": "Select a file to view",
            "input_prompt_text": "Random File Prompt",
            "confirm_msg": "Confirm file operation?",
            "confirm_target": "view:hub"
          }
        },
        "Input Check": {
          "target": "view:input",
          "state.set": {
            "input_header": "Input Search",
            "input_prompt_text": "Input Check Text Set!",
            "confirm_msg": "Does it work?",
            "confirm_target": "view:hub"
          }
        },
        "Quick Note": {
          "target": "view:input",
          "state.set": { "prompt_text": "Note Content:" }
        },
        "Exit": "exit",
        "Process Manager": {
          "target": "view:process_manager"
        }
      }
    },
    "pick_file": {
      "component": "gum file",
      "args": ["{{.dirname}}"],
      "env": {
        "GUM_FILE_CURSOR_FOREGROUND": "{{.styles.primary}}",
        "GUM_FILE_HEADER": "{{.pick_file_header}}",
        "GUM_FILE_HEADER_FOREGROUND": "{{.styles.accent}}",
        "GUM_FILE_SELECTED_FOREGROUND": "{{.styles.primary}}"
      },
      "handler": {
        "stdout": "selected_path",
        "success": {
          "target": "view:confirm"
        }
      }
    },
    "input": {
      "component": "gum input",
      "args": ["--placeholder", "{{.input_prompt_text}}"],
      "handler": {
        "stdout": "user_input",
        "success": {
          "target": "view:confirm",
          "state.set": {
            "confirm_msg": "{{.confirm_msg}} Enter: {{.user_input}}"
          }
        }
      },
      "env": {
        "GUM_INPUT_PROMPT": " ",
        "GUM_INPUT_PROMPT_FOREGROUND": "{{.styles.primary}}",
        "GUM_INPUT_CURSOR_FOREGROUND": "{{.styles.primary}}",
        "GUM_INPUT_HEADER": "{{.input_header}}",
        "GUM_INPUT_HEADER_FOREGROUND": "{{.styles.muted}}",
        "GUM_INPUT_WIDTH": "50"
      }
    },
    "confirm": {
      "component": "gum confirm",
      "args": ["{{.confirm_msg}}"],
      "handler": {
        "success": "{{.confirm_target}}"
      },
      "env": {
        "GUM_CONFIRM_PROMPT_FOREGROUND": "{{.styles.accent}}",
        "GUM_CONFIRM_SELECTED_BACKGROUND": "{{.styles.primary}}",
        "GUM_CONFIRM_SELECTED_FOREGROUND": "{{.styles.bg}}",
        "GUM_CONFIRM_UNSELECTED_FOREGROUND": "{{.styles.muted}}"
      }
    },
    "edit_file": {
      "component": "nvim",
      "args": ["{{.selected_path}}"],
      "handler": {
        "success": "view:hub"
      }
    },
    "pager": {
      "component": "sh",
      "args": ["-c", "gum pager", "<",  "{{.selected_path}}"],
      "handler": {
        "success": "view:hub"
      }
    },
    "process_manager": {
      "component": "zsh",
      "args": ["-c", "ps -eo pid,comm | fzf --header 'Select Process to Terminate'"],
      "handler": {
        "stdout": "selected_process",
        "success": {
          "target": "view:confirm",
          "state.set": {
            "confirm_msg": "Kill process: {{.selected_process}}?",
            "confirm_target": "view:kill_exec"
          }
        }
      }
    },
    "kill_exec": {
      "component": "sh",
      "args": ["-c", "echo {{.selected_process}} | awk '{print $1}' | xargs kill -9"],
      "handler": {
        "success": "view:hub"
      }
    }
  }
}
