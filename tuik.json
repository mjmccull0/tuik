{
  "main": "hub",
  "styles": {
    "primary": "212",
    "muted": "240",
    "accent": "86",
    "bg": "0"
  },
  "views": {
    "hub": {
      "component": "gum",
      "args": ["choose", "Pick File", "Input Check", "Quick Note", "Exit"],
      "handler": {
        "Pick File": "view:pick_file",
        "Input Check": {
          "target": "view:input",
          "state.set": {
            "prompt_text": "Input Prompt Text",
            "confirm_msg": "Does it work?",
            "confirm_target": "view:hub"
          }
        },
        "Quick Note": {
          "target": "view:input",
          "state.set": { "prompt_text": "Note Content:" }
        },
        "Exit": "exit"
      }
    },
    "pick_file": {
      "component": "gum file .",
      "env": {
        "GUM_FILE_CURSOR_FOREGROUND": "{{.styles.primary}}",
        "GUM_FILE_HEADER": "SELECT A FILE TO OPEN",
        "GUM_FILE_HEADER_FOREGROUND": "{{.styles.accent}}",
        "GUM_FILE_SELECTED_FOREGROUND": "{{.styles.primary}}"
      },
      "handler": {
        "stdout": "selected_path",
        "success": {
          "target": "view:confirm",
          "state.set": {
            "confirm_msg": "Edit {{.selected_path}}?",
            "confirm_target": "view:edit_file"
          }
        }
      }
    },
    "input": {
      "component": "gum input",
      "args": ["--placeholder", "{{.prompt_text}}"],
      "state.set": {
        "header": "FILE SEARCH ENGINE"
      },
      "handler": {
        "stdout": "user_input",
        "success": {
          "target": "view:confirm",
          "state.set": {
            "confirm_msg": "Edit {{.selected_path}}?",
            "confirm_target": "view:edit_file"
          }
        }
      },
      "env": {
        "GUM_INPUT_PROMPT": " ",
        "GUM_INPUT_PROMPT_FOREGROUND": "{{.styles.primary}}",
        "GUM_INPUT_CURSOR_FOREGROUND": "{{.styles.primary}}",
        "GUM_INPUT_HEADER": "{{.header}}",
        "GUM_INPUT_HEADER_FOREGROUND": "{{.styles.muted}}",
        "GUM_INPUT_WIDTH": "50"
      }
    },
    "confirm": {
      "component": "gum confirm",
      "args": ["{{.confirm_msg}}"],
      "handler": {
        "success": "{{.confirm_target}}"
      },
      "env": {
        "GUM_CONFIRM_PROMPT_FOREGROUND": "{{.styles.accent}}",
        "GUM_CONFIRM_SELECTED_BACKGROUND": "{{.styles.primary}}",
        "GUM_CONFIRM_SELECTED_FOREGROUND": "{{.styles.bg}}",
        "GUM_CONFIRM_UNSELECTED_FOREGROUND": "{{.styles.muted}}"
      }
    },
    "edit_file": {
      "component": "nvim",
      "args": ["{{.selected_path}}"],
      "handler": {
        "success": "view:hub"
      }
    }
  }
}
